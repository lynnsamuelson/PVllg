# Copy to backend/.env for local dev. Leave DB_HOST blank to use SQLite.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST. Defaults to the Vite dev server; add yours if Vite runs on another port or host.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL HeatWave via SSH tunnel (run scripts/db-tunnel.sh first):
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=hackathon
# DB_USER=admin
# DB_PASSWORD=

# DEBUG, INFO (default), WARNING or ERROR
# DJANGO_LOG_LEVEL=INFO
