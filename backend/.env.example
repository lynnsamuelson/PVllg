# Copy to backend/.env for local dev. Leave DB_HOST blank to use SQLite.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST. Defaults to the Vite dev server; add yours if Vite runs on another port or host.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL HeatWave via SSH tunnel (run scripts/db-tunnel.sh first):
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=hackathon
# DB_USER=admin
# DB_PASSWORD=

# Email (organization codes). Without EMAIL_HOST, emails print to the runserver console.
# EMAIL_HOST=smtp.email.us-ashburn-1.oci.oraclecloud.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=PVill <no-reply@localhost>
# Write emails to files in this folder instead of the console (the Playwright tests use this):
# EMAIL_FILE_PATH=

# DEBUG, INFO (default), WARNING or ERROR
# DJANGO_LOG_LEVEL=INFO
