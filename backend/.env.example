# Copy to backend/.env for local dev. Leave DB_HOST blank to use SQLite.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL HeatWave via SSH tunnel (run scripts/db-tunnel.sh first):
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=hackathon
# DB_USER=admin
# DB_PASSWORD=
